# ──────────────────────────────────────────────────────────────────────────────
# GramSathi AI Service – environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# development | production (production refuses to start if AI_SERVICE_API_KEY is empty)
ENV=development

# ── LLM provider ─────────────────────────────────────────────────────────────
# mock (default, no API key needed) | gemini (requires LLM_API_KEY and LLM_MODEL)
# When LLM_PROVIDER=gemini, pin a specific model name (e.g. gemini-2.0-flash);
# no alias default is used.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# ── Embedding provider ────────────────────────────────────────────────────────
# local (default, sentence-transformers multilingual model, no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Vector store & retrieval ──────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=data/chroma
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.45

# ── Internal service authentication ──────────────────────────────────────────
# Generate a strong random secret; must match AI_SERVICE_API_KEY in the
# Node.js backend .env.  Do NOT reuse the JWT secret.
AI_SERVICE_API_KEY=

# ── Knowledge-base data paths ─────────────────────────────────────────────────
FARMSATHI_DATA_PATH=../dataset/farmsathi
NYAYASATHI_DATA_PATH=../dataset/nyayasathi

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
